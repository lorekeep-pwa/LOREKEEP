# ==============================================================================
# 1. Server-side ONLY API credentials (for local `npm run dev` / `start:api`)
#    NEVER prefix private API keys with VITE_ and NEVER commit .env.local
# ==============================================================================
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
STEAMGRIDDB_API_KEY=
COVER_PROXY_PORT=8787

# ==============================================================================
# 2. Public Frontend URL for Cloudflare Pages (optional)
#    Set this in Cloudflare Pages -> Settings -> Environment Variables to your
#    deployed Cloudflare Worker URL (e.g. https://lorekeep-covers-api.<you>.workers.dev).
#    Leave empty in local dev or when routing /api/covers/* on the same domain.
# ==============================================================================
# VITE_COVER_API_BASE=https://lorekeep-covers-api.your-subdomain.workers.dev
