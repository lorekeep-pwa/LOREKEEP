    "@tiptap/extension-underline": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "jose": "^6.2.18",
    "lucide-react": "^0.475.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@neon/config": "^1.14.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
