  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start:api": "node server/cover-proxy.mjs",
    "build": "tsc -b && vite build",
    "db:migrate:neon": "node --env-file=.env.neon.local scripts/migrate-sync.mjs",
